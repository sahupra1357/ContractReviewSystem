# =============================================================================
# Contract Review Co-Pilot — full configuration reference
# =============================================================================
#
# HOW TO USE THIS FILE
#
#   Local runs : cp .env.example backend/.env   and uncomment what you need.
#                (pydantic-settings reads ./.env relative to the working
#                directory, and backend commands run from backend/.)
#   Docker     : docker-compose.yml sets these directly; no .env needed.
#   Render     : paste the keys you need into the dashboard's Environment tab.
#                Render turns them into real environment variables, which is
#                the same thing this file produces.
#
# EVERY LINE IS COMMENTED OUT AND SHOWS THE DEFAULT.
# The app runs correctly with this whole file commented out — that gives you
# the local compose stack. Uncomment a block only to switch that one piece.
#
# Precedence: real environment variables BEAT this file. Unknown/misspelled
# CRS_* keys are silently ignored (extra="ignore"), so check spelling first if
# a setting seems not to apply.
#
# .env and .env.* are gitignored. NEVER commit a filled-in copy.
# =============================================================================


# =============================================================================
# 1. DATABASE  (Postgres + pgvector)
# =============================================================================
#CRS_DATABASE_URL=postgresql+psycopg://crs:crs@localhost:5433/crs

# --- Managed Postgres (Render/Heroku-style) -------------------------------
# postgres:// URLs are normalized automatically in db.py.
#CRS_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
#
# Sharing an instance with another project? Isolate this app's 14 tables
# (users, jobs, documents, chunks, ... collide easily) with a dedicated
# schema — create it first: CREATE SCHEMA crsapp;
#CRS_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?options=-csearch_path%3Dcrsapp


# =============================================================================
# 2. OBJECT STORE  (raw / masked / audit zones)
# =============================================================================
# DEFAULT: local MinIO from docker-compose.
#CRS_S3_ENDPOINT_URL=http://localhost:9000
#CRS_S3_ACCESS_KEY=minioadmin
#CRS_S3_SECRET_KEY=minioadmin
#CRS_S3_REGION=us-east-1

# --- ENABLE CLOUDFLARE R2: set these four ---------------------------------
# No code change — boto3 speaks S3 to whatever endpoint it is given.
#CRS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#CRS_S3_ACCESS_KEY=<R2 access key id>
#CRS_S3_SECRET_KEY=<R2 secret access key>
#CRS_S3_REGION=auto
# ...plus this NON-CRS variable, or recent boto3 checksums make R2 reject
# uploads with a 400/501:
#AWS_REQUEST_CHECKSUM_CALCULATION=when_required

# --- ENABLE REAL AWS S3 ---------------------------------------------------
# Leave the endpoint unset to use AWS's own; supply IAM credentials instead.
#CRS_S3_ENDPOINT_URL=
#CRS_S3_REGION=us-east-1

# Bucket names — override only if these are taken in a shared account.
# Created automatically on first use if the credentials allow it.
#CRS_S3_BUCKET_RAW=raw
#CRS_S3_BUCKET_MASKED=masked
#CRS_S3_BUCKET_AUDIT=audit


# =============================================================================
# 3. PII TRIPWIRE  (Presidio — detector only, never masks)
# =============================================================================
# DEFAULT: the docker-compose analyzer.
#CRS_PRESIDIO_ANALYZER_URL=http://localhost:5002

# --- ENABLE PRESIDIO ON MODAL: set this one -------------------------------
# Deploy first: modal deploy deploy/modal_presidio.py
#CRS_PRESIDIO_ANALYZER_URL=https://<workspace>--crs-presidio-analyzer-web.modal.run

# Not used by any code path — the PII master table does all masking. Kept for
# compatibility; safe to omit entirely.
#CRS_PRESIDIO_ANONYMIZER_URL=http://localhost:5001


# =============================================================================
# 4. EMBEDDINGS  (index stage only; analyze needs no local model)
# =============================================================================
# DEFAULT: self-hosted BGE-M3 — the design's choice. Needs the `ml` extra
# (torch, ~8GB image) and downloads ~2.3GB of weights on first index job.
#CRS_EMBEDDING_PROVIDER=bge-m3

# --- ENABLE OPENAI EMBEDDINGS: set these three ----------------------------
# For hosts too small for torch. Requested at 1024 dims to match the existing
# pgvector column, so NO migration is needed.
#CRS_EMBEDDING_PROVIDER=openai
#CRS_EMBEDDING_MODEL=text-embedding-3-small
#CRS_EMBEDDING_API_KEY=<OpenAI API key>
# Any OpenAI-compatible endpoint (Azure, a local server, a proxy):
#CRS_EMBEDDING_BASE_URL=

# --- Test double only. Fast, offline, and MEANINGLESS retrieval quality. ---
#CRS_EMBEDDING_PROVIDER=hash
#
# NOTE: vectors are partitioned by model name, so providers can never be
# compared against each other. Switching provider requires a RE-INDEX; old
# chunks simply become invisible rather than producing wrong results.


# =============================================================================
# 5. ANALYSIS LLM
# =============================================================================
#CRS_LLM_PROVIDER=anthropic
#CRS_LLM_MODEL_STRONG=          # empty = provider default
#CRS_LLM_MODEL_FAST=
#CRS_LLM_API_KEY=               # empty = SDK resolves from the environment
#CRS_LLM_BASE_URL=

# Anthropic (default provider) reads this NON-CRS variable directly.
# In containers this replaces the local ~/.config/anthropic profile mount.
# Do NOT set it to an empty string — empty-but-set shadows the profile.
#ANTHROPIC_API_KEY=<Anthropic API key>

# --- ENABLE BEDROCK (production) ------------------------------------------
#CRS_LLM_PROVIDER=bedrock
#CRS_AWS_REGION=us-east-1

# --- ENABLE AN OPENAI-COMPATIBLE PROVIDER ---------------------------------
# openai | nvidia | mistral | minimax | kimi | qwen
#CRS_LLM_PROVIDER=openai
#CRS_LLM_API_KEY=<key>
#CRS_LLM_BASE_URL=<endpoint>


# =============================================================================
# 6. PIPELINE PLACEMENT
# =============================================================================
# DEFAULT: a separate worker service drains the queue
# (docker-compose `worker`, or render.yaml's crs-worker).
#CRS_INLINE_WORKER=0

# --- ENABLE THE IN-PROCESS PIPELINE: set this one -------------------------
# For hosts with no worker tier (Render free). The API process runs the same
# loop in a supervised daemon thread. Assumes ONE instance: orphaned `running`
# jobs are requeued at startup.
# WITHOUT THIS, ON A HOST WITH NO WORKER, NOTHING IS PROCESSED — every
# document sits at `uploaded` forever.
#CRS_INLINE_WORKER=1


# =============================================================================
# 7. EXTRACTION / OCR
# =============================================================================
# Ordered cheapest-first; a page below the threshold retries the next engine.
# Engines whose library is not installed are skipped and audited.
#CRS_OCR_ENGINE_CHAIN=tesseract,paddleocr,easyocr,docling
# All engines below this → extract_hold for a human (fail-closed).
#CRS_OCR_CONFIDENCE_THRESHOLD=0.80
# Pages rasterized at once — caps peak memory on long documents.
#CRS_OCR_BATCH_SIZE=16
# Above this page count → extract_hold with reason `oversized`.
#CRS_EXTRACT_MAX_PAGES=1000


# =============================================================================
# 8. AUTH, UI, MISC
# =============================================================================
# CHANGE THIS ANYWHERE REACHABLE FROM THE INTERNET. POC only; Cognito in prod.
#CRS_JWT_SECRET=dev-secret-change-me

# Password for the seeded demo users (reviewer1/reviewer2/admin1).
# Read directly by seed_users.py, not through Settings.
#CRS_DEMO_PASSWORD=demo1234

# Extra browser origins allowed to call the API, comma-separated. Required
# when the SPA is hosted apart from the API (Vercel). localhost:5173 is always
# allowed. Never a wildcard: the API takes Bearer tokens.
#CRS_CORS_ALLOW_ORIGINS=https://<project>.vercel.app,https://<preview>.vercel.app

# Built React UI. The Docker image already sets this to /app/static.
#CRS_STATIC_DIR=

# Reported by /health — handy for confirming which deployment you are hitting.
#CRS_ENVIRONMENT=local

# Set to 1 to run the invariant test suite (needs Postgres + migrations).
#CRS_RUN_INVARIANT_TESTS=1


# =============================================================================
# 9. BUILD-TIME ONLY  (NOT read at runtime — these need a REBUILD, not a
#    restart, and belong wherever the image/bundle is built)
# =============================================================================
# Which Python extras go into the backend image. Render exposes environment
# variables as Docker build args, so setting it there reaches the Dockerfile.
#   ml     = default; torch + sentence-transformers for BGE-M3 (~8.66GB image)
#   openai = hosted embeddings only (~697MB image)
#CRS_EXTRAS=ml

# Frontend: the API base URL, inlined into the JS bundle at build time.
# Set in Vercel's project settings. Changing it requires a redeploy.
# Unset = same origin (correct when the backend serves the SPA).
#VITE_API_URL=https://<service>.onrender.com
